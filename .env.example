# Copy to .env.local (or .dev.vars for Wrangler) and fill in real values.
# Never commit real secrets.

# --- Client-safe (exposed to the browser via Vite's VITE_ prefix) ---
VITE_SUPABASE_URL="https://ovcuyfsgxbkchenmvdwa.supabase.co"
VITE_SUPABASE_PROJECT_ID="ovcuyfsgxbkchenmvdwa"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Server-only (never prefix with VITE_, never send to the browser) ---
SUPABASE_URL="https://ovcuyfsgxbkchenmvdwa.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Service role key: bypasses RLS. Server-only. Required for the password
# recovery-code flow (client.server.ts). Set as a Cloudflare secret in
# production (`wrangler secret put SUPABASE_SERVICE_ROLE_KEY`), never as a
# plain env var and never with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional: cron endpoint auth (only if/when a cron route is added) ---
CRON_SECRET=""
CRON_SECRET_PREVIOUS=""
